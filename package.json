{
  "name": "sve-workspace",
  "private": true,
  "type": "module",
  "description": "Shadowverse: Evolve rules engine workspace (personal/test use only).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:gui": "npm run dev -w @sve/gui -- --open",
    "build:gui": "npm run build -w @sve/gui",
    "test:gui": "npm run test:e2e -w @sve/gui",
    "android:apk": "node packages/gui/scripts/android-apk.mjs",
    "ios:ipa": "node packages/gui/scripts/ios-ipa.mjs",
    "release:pc": "tsx packages/gui/scripts/release-pc.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/core/tsconfig.test.json && tsc -p packages/bot/tsconfig.json && tsc -p packages/bot/tsconfig.test.json && tsc -p tools/tsconfig.json && tsc -p packages/gui/tsconfig.json && tsc -p packages/gui/tsconfig.node.json",
    "build:cards": "tsx tools/build-card-data.ts",
    "rules:clauses": "tsx tools/extract-cr-clauses.ts",
    "rules:index": "tsx tools/rules-index.ts",
    "cards:status": "tsx tools/card-status.ts",
    "card": "tsx tools/show-card.ts",
    "scripts:index": "tsx tools/gen-script-index.ts",
    "bench": "tsx tools/bench.ts",
    "bot:arena": "tsx tools/bot-arena.ts",
    "bench:throughput": "tsx tools/throughput.ts",
    "rl:coverage": "tsx tools/rl-coverage.ts",
    "rl:behaviour": "tsx tools/rl-behaviour.ts",
    "rl:lethal": "tsx tools/rl-lethal.ts",
    "rl:ingest": "tsx tools/rl-ingest.ts",
    "release:train": "tsx tools/build-train-kit.ts",
    "rl:verify": "tsx tools/rl-verify.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
